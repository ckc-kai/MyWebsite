---
import { STATIONS } from '../../lib/journey';

interface Props {
  lang: 'zh' | 'en';
  label: string;
}

const { lang, label } = Astro.props;
const labelled = Object.values(STATIONS).filter((station) => station.showLabel);
---

<div class="globe" data-globe>
  <canvas tabindex="0" role="img" aria-label={label}></canvas>
  <ul class="globe-labels" aria-hidden="true">
    {labelled.map((station) => (
      <li data-station={station.id} data-side={station.labelSide}>
        <span>{station.name[lang]}</span>
      </li>
    ))}
  </ul>
</div>

<script>
  import { mountGlobe } from './mount';

  for (const element of document.querySelectorAll<HTMLElement>('[data-globe]')) {
    mountGlobe(element);
  }
</script>

<style>
  .globe {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  canvas:focus-visible {
    outline-offset: -4px;
  }

  .globe-labels li {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    white-space: nowrap;
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1;
    pointer-events: none;
    transition: opacity var(--duration-fast) ease;
    /* A halo in the page colour keeps labels readable over land and routes. */
    text-shadow:
      0 0 3px var(--color-bg),
      0 0 3px var(--color-bg),
      0 0 6px var(--color-bg);
  }

  .globe-labels span {
    display: block;
    transform: translate(11px, -50%);
  }

  .globe-labels [data-side='left'] span {
    transform: translate(calc(-100% - 11px), -50%);
  }
</style>
