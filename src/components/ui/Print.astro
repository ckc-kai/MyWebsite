---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  /** Degrees. A print laid on a desk is never quite square to it. */
  tilt?: number;
}

/** Prints are never drawn wider than 15rem (240 px): twice that keeps them sharp on a retina screen. */
const DISPLAY_WIDTH_PX = 480;
const { src, alt, caption, tilt = 0 } = Astro.props;
---

<figure class="print" style={`--tilt: ${tilt}deg`}>
  <!-- AVIF where the browser reads it, WebP otherwise. Low priority: prints wait in the wings until their
       stop is read, so they must never hold up the first screen's fonts and script. -->
  <Picture src={src} alt={alt} width={DISPLAY_WIDTH_PX} formats={['avif']} fallbackFormat="webp" loading="lazy" fetchpriority="low" />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  /* A photograph kept in its own colours, shown as a small print with a pencilled note. */
  .print {
    width: var(--print-width, 15rem);
    margin: 0;
    transform: rotate(var(--tilt));
  }

  .print img {
    display: block;
    width: 100%;
    height: auto;
    border: 5px solid var(--color-print-border);
    box-shadow: 0 6px 18px -8px rgb(0 0 0 / 0.45);
  }

  .print figcaption {
    margin-top: 6px;
    padding-left: 4px;
    font-family: var(--font-hand);
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--color-study);
  }
</style>
