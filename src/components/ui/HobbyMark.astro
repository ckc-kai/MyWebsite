---
import type { HobbyKey } from '../../content/zh';

interface Props {
  hobby: HobbyKey;
  label: string;
}

const { hobby, label } = Astro.props;
---

<figure class="hobby">
  <svg viewBox="0 0 64 64" aria-hidden="true">
    {hobby === 'tennis' && (
      <>
        <ellipse cx="25" cy="25" rx="14" ry="18" transform="rotate(-32 25 25)" />
        <path d="M17 13 L35 39 M11 23 L29 47 M33 12 L14 33 M40 22 L21 42" class="hobby__thin" />
        <path d="M35 40 L52 58" />
        <circle cx="51" cy="16" r="6" class="hobby__fill" />
      </>
    )}
    {hobby === 'gym' && (
      <g transform="rotate(-18 32 32)">
        <path d="M18 32 H46" />
        <rect x="11" y="19" width="7" height="26" rx="2" class="hobby__fill" />
        <rect x="46" y="19" width="7" height="26" rx="2" class="hobby__fill" />
        <path d="M6 25 V39 M58 25 V39" />
      </g>
    )}
    {hobby === 'reading' && (
      <>
        <path d="M8 17 C 18 12, 26 13, 32 20 C 38 13, 46 12, 56 17 V 49 C 46 44, 38 45, 32 52 C 26 45, 18 44, 8 49 Z" />
        <path d="M32 20 V52" />
        <path d="M14 26 C 19 24, 23 24, 27 27 M14 34 C 19 32, 23 32, 27 35" class="hobby__thin" />
        <path d="M37 27 C 41 24, 45 24, 50 26" class="hobby__mark" />
      </>
    )}
    {hobby === 'photo' && (
      <>
        <path d="M10 22 H22 L26 15 H40 L44 22 H54 a3 3 0 0 1 3 3 V48 a3 3 0 0 1 -3 3 H10 a3 3 0 0 1 -3 -3 V25 a3 3 0 0 1 3 -3 Z" />
        <circle cx="33" cy="36" r="10" />
        <circle cx="33" cy="36" r="4.5" class="hobby__fill" />
        <path d="M14 29 H19" />
      </>
    )}
  </svg>
  <figcaption>{label}</figcaption>
</figure>

<style>
  /* Drawn with the same pen as the arrows: one weight, round ends, one touch of highlighter. */
  .hobby {
    display: grid;
    justify-items: center;
    gap: 2px;
    margin: 0;
  }

  svg {
    width: 3.25rem;
    height: 3.25rem;
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hobby__thin {
    stroke-width: 1.1;
  }

  .hobby__fill {
    fill: var(--color-marker);
  }

  .hobby__mark {
    stroke: var(--color-marker);
    stroke-width: 5;
  }

  figcaption {
    font-family: var(--font-hand);
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--color-study);
  }
</style>
