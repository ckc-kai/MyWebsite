---
import { copyFor, type Lang } from '../../content';
import { compactSvg } from '../../lib/svg-path';
import { FIGURE_SIZE, buildPipelineFigure } from './pipeline-figure';
import './figure.css';
import './flagship.css';

interface Props {
  lang: Lang;
}

const flagship = copyFor(Astro.props.lang).flagship;
const copy = flagship.report;
const figure = buildPipelineFigure();
/** The bench leaves empty room above the chart board and below its front edge; both are trimmed (the bottom keeps its shadow). */
const HEADROOM = 64;
const FOOTROOM = 56;
const VIEW_HEIGHT = FIGURE_SIZE.height - HEADROOM - FOOTROOM;
---

<div
  class="flag"
  data-report
  data-stops={JSON.stringify(figure.stops)}
  data-running="false"
  data-no-drag
  style={`--travel-x: ${figure.travel[0]}px; --travel-y: ${figure.travel[1]}px; --flag-aspect: ${FIGURE_SIZE.width / VIEW_HEIGHT}`}
>
  <header class="figure__label">
    <h3>{copy.title}</h3>
  </header>

  <div class="flag__main">
  <div class="flag__drawing iso" data-globe-clear>
    <svg class="iso-svg" viewBox={`0 ${HEADROOM} ${FIGURE_SIZE.width} ${VIEW_HEIGHT}`} aria-hidden="true" set:html={compactSvg(figure.svg)} />
  </div>
  <p class="flag__swipe">{flagship.swipe}</p>
  <p class="flag__figcaption">
    {copy.schedule}
    <span class="flag__spec flag__spec--inline">{copy.scheduleSpec}</span>
  </p>
  <div class="flag__cue">
    <p class="flag__hint">{copy.hint}</p>
    <button type="button" class="figure__run" data-run>{copy.run}</button>
  </div>

  <ol class="flag__stepper">
    {copy.stages.map((stage, index) => (
      <li>
        <button type="button" data-step={index} aria-pressed={index === 0 ? 'true' : 'false'}>
          <b>{index + 1}</b>
          {stage.name}
        </button>
      </li>
    ))}
  </ol>

  </div>

  <div class="flag__side" data-globe-clear>
    <section class="flag__info" aria-live="polite">
      {copy.stages.map((stage, index) => (
        <article data-step-text={index} hidden={index !== 0}>
          <h4>{stage.name}</h4>
          <p>{stage.text}</p>
          <p class="flag__spec">
            <span>{flagship.specLabel}</span>
            {stage.spec}
          </p>
        </article>
      ))}
    </section>

    <section class="flag__aside">
      <p class="figure__sub">{copy.pointsLabel}</p>
      {copy.stages.map((stage, index) => (
        <ol class="flag__points" data-step-points={index} hidden={index !== 0}>
          {stage.points.map((point) => <li>{point}</li>)}
        </ol>
      ))}
    </section>
  </div>

</div>

<script>
  const STOP_MS = 1500;

  for (const figure of document.querySelectorAll<HTMLElement>('[data-report]')) {
    const stopsData: unknown = JSON.parse(figure.dataset.stops ?? '[]');
    const stops = Array.isArray(stopsData) ? stopsData.map(Number) : [];
    const stations = [...figure.querySelectorAll<SVGGElement>('.fig-station')];
    const glows = [...figure.querySelectorAll<SVGPathElement>('.fig-glow')];
    const steps = [...figure.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const texts = [...figure.querySelectorAll<HTMLElement>('[data-step-text]')];
    const points = [...figure.querySelectorAll<HTMLElement>('[data-step-points]')];
    const courier = figure.querySelector<SVGGElement>('[data-courier]');
    const run = figure.querySelector<HTMLButtonElement>('[data-run]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0;

    const choose = (index: number): void => {
      for (const station of stations) station.classList.toggle('is-active', Number(station.dataset.station) === index);
      for (const glow of glows) glow.classList.toggle('is-active', Number(glow.dataset.station) === index);
      for (const step of steps) step.setAttribute('aria-pressed', String(Number(step.dataset.step) === index));
      for (const text of texts) text.hidden = Number(text.dataset.stepText) !== index;
      for (const list of points) list.hidden = Number(list.dataset.stepPoints) !== index;
      courier?.style.setProperty('--at', String(stops[index] ?? 0));
      figure.dataset.active = String(index);
    };

    const stop = (): void => {
      window.clearInterval(timer);
      figure.dataset.running = 'false';
    };

    for (const target of [...stations, ...steps]) {
      target.addEventListener('click', () => {
        stop();
        choose(Number(target.dataset.station ?? target.dataset.step));
      });
    }

    // Follow one report down the line, stopping under each station in turn.
    run?.addEventListener('click', () => {
      stop();
      choose(0);
      if (reducedMotion.matches) return;
      figure.dataset.running = 'true';
      let index = 0;
      timer = window.setInterval(() => {
        index += 1;
        if (index >= stops.length) stop();
        else choose(index);
      }, STOP_MS);
    });

    choose(0);
  }
</script>
