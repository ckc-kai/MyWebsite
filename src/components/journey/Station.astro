---
import { copyFor, type Lang } from '../../content';
import type { StationCopy } from '../../content/types';
import DeskFigure from '../anatomy/DeskFigure.astro';
import ReportFigure from '../anatomy/ReportFigure.astro';
import SemgFigure from '../anatomy/SemgFigure.astro';
import HobbyMark from '../ui/HobbyMark.astro';
import Print from '../ui/Print.astro';
import RichText from '../ui/RichText.astro';
import Contact from '../site/Contact.astro';
import WestLake from '../westlake/WestLake.astro';
import Paper from './Paper.astro';
import { printsFor } from './photos';

interface Props {
  station: StationCopy;
  /** Position along the journey, used to give each stop its own highlighter. */
  index: number;
  lang: Lang;
}

const MARKER_COUNT = 4;

/** A print is sized by its shape, so an upright one does not tower over the copy. */
const PRINT_WIDTH = { landscape: '13.5rem', portrait: '9.5rem', square: '11rem' };

const { station, index, lang } = Astro.props;
const { listJoiner } = copyFor(lang).site;
// On wide screens these prints are pinned to the globe instead (see Journey.astro); here they are the narrow-screen copy.
const photos = printsFor(station.photos).map((photo) => ({ ...photo, width: PRINT_WIDTH[photo.shape] }));
const layout = station.machine ? 'machine' : station.paper ? 'paper' : 'story';
const photoGroup = photos.length > 2 ? 'row' : photos.length === 2 ? 'pair' : 'single';
---

<section
  class="station"
  id={station.id}
  data-stop={station.id}
  data-kind={station.kind}
  data-layout={layout}
  data-single-lines={station.singleLines ? '' : undefined}
  data-mark={index % MARKER_COUNT}
  aria-labelledby={`${station.id}-title`}
>
  <div class="station__copy" data-no-drag data-globe-clear>
    <p class="station__when">
      {station.when}
      {station.role && <span>{station.role}</span>}
    </p>
    <h2 id={`${station.id}-title`}>{station.title}</h2>
    <p class="station__place">{station.place}</p>
    <p class="station__lead"><RichText text={station.lead} /></p>
    {station.sketches && <WestLake sketches={station.sketches} label={station.sketchesLabel ?? ''} />}

    {station.result && (
      <p class="station__result">
        <span>{station.result.label}</span>
        <b>{station.result.from}</b>
        <i aria-hidden="true">→</i>
        <b>{station.result.to}</b>
      </p>
    )}

    {station.school && (
      <div class="school">
        <p class="school__degrees">{station.school.degrees.map((degree) => <span>{degree}</span>)}</p>
        <p class="school__honors"><RichText text={station.school.honors} /></p>
        <p class="school__courses">
          <b>{station.school.coursesLabel}</b>
          {station.school.courses.join(listJoiner)}
        </p>
      </div>
    )}

    {station.passages && (
      <div class="passages">
        {station.passages.map((passage) => (
          <div>
            {passage.title && <h3 lang="en">{passage.title}</h3>}
            <p><RichText text={passage.text} /></p>
          </div>
        ))}
      </div>
    )}

    {station.hobbies && (
      <div class="station__hobbies">
        {station.hobbiesTitle && <h3>{station.hobbiesTitle}</h3>}
        <div>{station.hobbies.map((hobby) => <HobbyMark hobby={hobby.key} label={hobby.label} />)}</div>
      </div>
    )}

    {photos.length > 0 && (
      <div class="station__photos" data-group={photoGroup}>
        {photos.map((photo) => (
          <div style={`--print-width: ${photo.width}`}>
            <Print src={photo.src} alt={photo.alt} caption={photo.caption} tilt={photo.tilt} />
          </div>
        ))}
      </div>
    )}
    {station.contacts && <Contact title={station.contactTitle ?? ''} contacts={station.contacts} />}
  </div>

  {station.paper && <Paper paper={station.paper} />}
  {station.machine === 'report' && <ReportFigure lang={lang} />}
  {station.machine === 'semg' && <SemgFigure lang={lang} />}
  {station.machine === 'desk' && <DeskFigure lang={lang} />}
</section>
