---
import { Image } from 'astro:assets';
import childCutout from '../../assets/child-cutout.png';
import { JOURNEY_ZH as journey, OPENING_ZH as opening, SITE_ZH as site } from '../../content/zh';
import { findStop } from '../../lib/journey';
import Print from '../ui/Print.astro';
import Globe from '../globe/Globe.astro';
import Opening from '../opening/Opening.astro';
import Station from './Station.astro';
import { printsFor } from './photos';
import './journey.css';

// Each stop's photographs, laid on the globe beside the place they were taken.
const boards = journey.stations
  .filter((station) => (station.photos ?? []).length > 0)
  .map((station) => ({ id: station.id, pin: findStop(station.id)?.station ?? null, prints: printsFor(station.photos) }));
---

<div class="journey" data-globe-stage data-active="top">
  <div class="journey__stage">
    <Globe lang="zh" label={site.globeLabel} />
    <div class="journey__anchor" data-globe-anchor aria-hidden="true"></div>

    <!-- Pinned to Hangzhou on the globe: he stands where the story starts, and turns with it. -->
    <figure class="kid" data-globe-pin="HZ">
      <Image class="kid__photo" src={childCutout} alt={opening.kidAlt} height={420} densities={[1, 2]} loading="eager" />
      <figcaption class="kid__note">{opening.kidNote}</figcaption>
    </figure>

    <!-- The photographs of each stop, pinned beside its place and turning with the globe; a stop with no
         place of its own lays its prints out on the right instead. Wide screens only. -->
    {boards.map((board) => (
      <div
        class:list={['map-prints', { 'map-prints--free': board.pin === null }]}
        data-globe-pin={board.pin ?? undefined}
        data-prints-for={board.id}
        data-count={board.prints.length}
      >
        <div class="map-prints__inner">
          {board.prints.map((print) => (
            <div class="map-prints__item" data-shape={print.shape}>
              <Print src={print.src} alt={print.alt} caption={print.caption} tilt={print.tilt} />
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <Opening />
  {journey.stations.map((station, index) => <Station station={station} index={index} />)}
</div>

<script>
  import { observeJourney } from './observe';

  for (const stage of document.querySelectorAll<HTMLElement>('.journey')) {
    observeJourney(stage);
  }
</script>
