---
import { JOURNEY_ZH as journey, SITE_ZH as site } from '../../content/zh';
import ThemeToggle from '../ui/ThemeToggle.astro';

const MARKER_COUNT = 4;
---

<header class="site-header" data-no-drag>
  <a class="site-header__id" href="#top"><b>{site.name}</b><span lang="en">{site.nameLatin}</span></a>

  <!-- The rail is the route in miniature: a stop per place, joined the way the map joins them. -->
  <nav class="site-header__rail" aria-label={site.railLabel}>
    <ol>
      {journey.stations.map((station, index) => (
        <li data-kind={station.kind}>
          <a href={`#${station.id}`} data-rail={station.id} data-mark={index % MARKER_COUNT}>
            <span>{station.rail}</span>
            <i aria-hidden="true"></i>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="site-header__tools">
    <a aria-disabled="true">{site.navGlance}</a>
    <a aria-disabled="true" lang="en" aria-label={site.navLanguage}>
      <span data-long>{site.navLanguage}</span><span data-short aria-hidden="true">{site.navLanguageShort}</span>
    </a>
    <ThemeToggle groupLabel={site.themeGroup} dayLabel={site.themeDay} nightLabel={site.themeNight} />
  </div>
</header>

<style>
  .site-header {
    --dot: 9px;
    position: fixed;
    inset: 0 0 auto;
    z-index: 5;
    display: flex;
    align-items: flex-start;
    gap: 8px 30px;
    height: var(--header-height);
    padding: 14px var(--gutter) 0;
    font-size: 1rem;
    line-height: 1.4;
    /* Fades out instead of ending on an edge, so nothing draws a line across the globe. */
    background: linear-gradient(to bottom, var(--color-bg) 55%, transparent);
  }

  /* The name is set as a masthead: the Chinese in the display face, the Latin riding beside it. */
  .site-header__id {
    display: flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__id b {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 900;
    line-height: 1.2;
  }

  .site-header__id span {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--color-ink-soft);
  }

  .site-header__rail {
    min-width: 0;
    padding-top: 3px;
  }

  .site-header__rail ol {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__rail li {
    position: relative;
  }

  .site-header__rail a {
    display: grid;
    justify-items: center;
    gap: 5px;
    padding: 0 9px;
    font-size: var(--text-small);
    line-height: 1.3;
    color: var(--color-ink-faint);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--duration-fast) ease;
  }

  /* The leg arriving at a stop: solid blue for study, dotted orange for work, as on the globe. */
  .site-header__rail li + li::before {
    content: '';
    position: absolute;
    right: 50%;
    bottom: calc(var(--dot) / 2 - 1px);
    width: 100%;
    border-top: 2px solid var(--color-study);
    opacity: 0.3;
    transition: opacity var(--duration-normal) ease;
  }

  .site-header__rail li + li[data-kind='work']::before {
    border-top-style: dotted;
    border-top-color: var(--color-work);
  }

  .site-header__rail li[data-reached]::before {
    opacity: 1;
  }

  /* The stop itself: hollow until reached, filled once passed, ringed and tinted where you are. */
  .site-header__rail i {
    position: relative;
    z-index: 1;
    width: var(--dot);
    height: var(--dot);
    border: 2px solid var(--color-ink-faint);
    border-radius: 50%;
    background: var(--color-bg);
    transition:
      transform var(--duration-normal) var(--ease-out-expo),
      background-color var(--duration-normal) ease,
      border-color var(--duration-normal) ease;
  }

  .site-header__rail li[data-reached] i {
    border-color: var(--color-ink);
    background: var(--color-ink);
  }

  .site-header__rail a[aria-current='true'] i {
    border-color: var(--color-ink);
    background: var(--mark, var(--color-marker));
    transform: scale(1.55);
  }

  .site-header__rail a:hover,
  .site-header__rail li[data-reached] a,
  .site-header__rail a[aria-current='true'] {
    color: var(--color-ink);
  }

  .site-header__rail a:hover i {
    transform: scale(1.3);
  }

  .site-header__rail a[aria-current='true'] span {
    font-weight: 600;
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-left: auto;
    padding-top: 2px;
    white-space: nowrap;
  }

  .site-header__tools a {
    color: var(--color-ink-soft);
  }

  [data-short] {
    display: none;
  }

  @media (max-width: 1180px) {
    .site-header__id span,
    [data-long] {
      display: none;
    }

    [data-short] {
      display: inline;
    }

    .site-header {
      gap: 8px 16px;
    }

    .site-header__rail a {
      padding: 0 6px;
    }
  }

  @media (max-width: 820px) {
    /* Two rows: name and tools, then the route as a strip that scrolls sideways. */
    .site-header {
      flex-wrap: wrap;
      align-content: flex-start;
      padding-top: 10px;
      background: var(--color-bg);
    }

    .site-header__id b {
      font-size: 1.1875rem;
    }

    .site-header__tools {
      gap: 10px;
    }

    .site-header__rail {
      order: 3;
      width: 100%;
      padding: 0 0 8px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .site-header__rail::-webkit-scrollbar {
      display: none;
    }

    .site-header__rail a {
      padding: 0 10px;
    }
  }
</style>
