---
import { copyFor, type Lang } from '../../content';

interface Props {
  lang: Lang;
}

const { site } = copyFor(Astro.props.lang);
---

<p class="motto"><i lang="la">{site.motto}</i><span>{site.mottoGloss}</span></p>

<style>
  /* The mark at the foot of every screen: small, centred, out of the way. */
  .motto {
    position: fixed;
    left: 50%;
    bottom: 12px;
    z-index: 4;
    display: flex;
    align-items: baseline;
    gap: 0.55em;
    margin: 0;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.6875rem;
    line-height: 1.3;
    color: var(--color-ink-faint);
    pointer-events: none;
    text-shadow:
      0 0 3px var(--color-bg),
      0 0 8px var(--color-bg);
  }

  /* Long stops scroll copy underneath: a patch of page colour, fading out at its edges, keeps the mark legible
     without making the mark itself any bigger. */
  .motto::before {
    content: '';
    position: absolute;
    inset: -14px -44px -12px;
    z-index: -1;
    background: radial-gradient(closest-side, var(--color-bg) 62%, transparent);
  }

  .motto i {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
  }

  @media (max-width: 820px) {
    /* On a phone the foot of the screen is the reading area, so the mark gets a slim strip of its own. */
    .motto {
      left: 0;
      right: 0;
      bottom: 0;
      justify-content: center;
      padding: 4px var(--gutter) 5px;
      transform: none;
      background: var(--color-bg);
      text-shadow: none;
    }

    .motto::before {
      content: none;
    }
  }
</style>
