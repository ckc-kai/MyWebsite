---
import Journey from '../components/journey/Journey.astro';
import Motto from '../components/site/Motto.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import { HTML_LANG, copyFor } from '../content';
import Base from '../layouts/Base.astro';

const LANG = 'zh';
const { site } = copyFor(LANG);
---

<Base lang={HTML_LANG[LANG]} title={site.title} description={site.description} alternate={{ lang: HTML_LANG.en, path: 'en/' }}>
  <SiteHeader lang={LANG} />
  <main>
    <Journey lang={LANG} />
  </main>
  <Motto lang={LANG} />
</Base>
