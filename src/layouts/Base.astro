---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import InkSelection from '../components/site/InkSelection.astro';
import { DAY_START_HOUR, NIGHT_START_HOUR, THEME_STORAGE_KEY } from '../lib/theme';

interface Props {
  title: string;
  description: string;
  lang: string;
  /** The same page in the other language, for search engines and browsers. */
  alternate?: { lang: string; path: string };
}

const { title, description, lang, alternate } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
/** Search engines want the other language's address in full. */
const absolute = (path: string): string => new URL(`${base}${path}`, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={description} />
    {alternate && <link rel="alternate" hreflang={alternate.lang} href={absolute(alternate.path)} />}
    <!-- Runs before first paint so the page never flashes the wrong theme. -->
    <script is:inline define:vars={{ DAY_START_HOUR, NIGHT_START_HOUR, THEME_STORAGE_KEY }}>
      (() => {
        let override = null;
        try {
          override = sessionStorage.getItem(THEME_STORAGE_KEY);
        } catch {
          // Storage can be blocked (private mode); the clock alone decides then.
        }
        // `?theme=night` wins over everything, so either view can be linked to directly.
        const requested = new URLSearchParams(location.search).get('theme');
        const hour = new Date().getHours();
        const byClock = hour >= DAY_START_HOUR && hour < NIGHT_START_HOUR ? 'day' : 'night';
        const isTheme = (value) => value === 'day' || value === 'night';
        document.documentElement.dataset.theme = isTheme(requested) ? requested : isTheme(override) ? override : byClock;
      })();
    </script>
  </head>
  <body>
    <slot />
    <InkSelection />
  </body>
</html>
